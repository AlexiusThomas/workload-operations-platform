[flake8]
# Consistent with black (line-length = 100).
max-line-length = 100
# E203 (whitespace before ':') and W503 (line break before binary operator)
# conflict with black's formatting; disable per black's recommendation.
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    cdk.out,
    node_modules,
    frontend
